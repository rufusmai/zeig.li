{
  "database": [
    {
      "instance": "zeig-ml",
      "rules": "database.rules.json"
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "ignore": [
      "node_modules",
      ".git",
      ".yarn",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "src",
      "tsconfig.json"
    ],
    "predeploy": ["yarn --cwd \"$RESOURCE_DIR\" build"]
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/authorize",
        "destination": "/authorize.html"
      },
      {
        "source": "/error",
        "destination": "/error.html"
      },
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/**",
        "function": {
          "functionId": "urlShortener",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true
    }
  }
}
