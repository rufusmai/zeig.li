{
  "database": [
    {
      "instance": "zeig-ml",
      "rules": "database.rules.json"
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "ignore": [
      "node_modules",
      ".git",
      ".yarn",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": ["yarn --cwd \"$RESOURCE_DIR\" build"]
  },
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://*.demo.rufusmai.com http://*.demo.localhost:*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/authorize",
        "destination": "/index.html"
      },
      {
        "source": "/error",
        "destination": "/index.html"
      },
      {
        "source": "/de",
        "destination": "/de.html"
      },
      {
        "source": "/de/authorize",
        "destination": "/de/authorize.html"
      },
      {
        "source": "/de/error",
        "destination": "/de/error.html"
      },
      {
        "source": "/en",
        "destination": "/en.html"
      },
      {
        "source": "/en/authorize",
        "destination": "/en/authorize.html"
      },
      {
        "source": "/en/error",
        "destination": "/en/error.html"
      },
      {
        "source": "/**",
        "function": {
          "functionId": "urlShortener",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true
    }
  }
}
